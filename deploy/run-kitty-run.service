[Unit]
Description=Run Kitty Run game server
After=network.target

[Service]
User=rkr
Group=rkr
WorkingDirectory=/opt/run-kitty-run/app
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=8080
# player feedback is appended to $STATE_DIRECTORY/feedback.jsonl (= /var/lib/run-kitty-run)
StateDirectory=run-kitty-run
StateDirectoryMode=0700
UMask=0077
Environment=FEEDBACK_FILE=/var/lib/run-kitty-run/feedback.jsonl
# player reports (chat moderation) go next to it
Environment=REPORTS_FILE=/var/lib/run-kitty-run/reports.jsonl
# app deep links (served at /.well-known/*): Apple Developer team id, and the Play app-signing cert SHA-256
# (Play Console > App integrity; comma-separate several, e.g. upload + signing keys)
#Environment=APPLE_TEAM_ID=ABCDE12345
#Environment=ANDROID_CERT_SHA256=AA:BB:...:FF
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=2
# sandboxing: the game can't see other users' files (the box also runs the DSH lab)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
ProtectKernelModules=true
ProtectHostname=true
ProtectClock=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
